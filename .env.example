# Copie para .env e preencha. O .env NUNCA vai pro git.

# --- Django ---
DEBUG=True
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Endereços pelos quais o app pode ser acessado. O Docker Compose acrescenta
# o notebook isaque e http://isaque:${WEB_PORT:-8020} às listas abaixo.
# Para acessar por IP, inclua-o nas duas listas (na origem, com http:// e porta).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8020,http://127.0.0.1:8020
SECURE_SSL_REDIRECT=True

# --- Banco (Postgres no docker-compose) ---
DB_NAME=naicas_db
DB_USER=naicas_user
DB_PASSWORD=
# Host/porta do Postgres. No Docker Compose o serviço web já recebe db:5432;
# só mude se rodar o Django fora do Compose.
DB_HOST=db
DB_PORT=5432

# --- Portas no host ---
# 0.0.0.0   = aparelhos que alcancem esta máquina (padrão para a rede local).
# 127.0.0.1 = só esta máquina (recomendado na VPS atrás do Tailscale/proxy).
WEB_BIND=0.0.0.0
WEB_PORT=8020
DB_HOST_PORT=5436

# --- Gunicorn (só em produção, DEBUG=False) ---
GUNICORN_WORKERS=3

# --- Deploy (atualizar.sh) ---
# Host usado no healthcheck; precisa estar em ALLOWED_HOSTS
HEALTHCHECK_HOST=localhost

# --- SSO Keycloak (pós-MVP; vazio = desligado) ---
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
